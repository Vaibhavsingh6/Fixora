# ==============================================================================
# Fixora - Environment Configuration Template
# ==============================================================================
# NOTE: Copy this file to `.env` or appropriate subpackage `.env` files for local development.
# NEVER commit actual `.env` files with secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Environment Variables (server/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Admin Invite Secret (used to authorize creation of 'admin' role accounts)
ADMIN_SECRET_KEY=change-this-to-a-secure-admin-secret-key

# Google Gemini API Key (PHASE 2 PREPARATION ONLY - NEVER EXPOSE TO FRONTEND)
# Stored solely on the backend server; not accessible to client-side bundles.
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin Project Configuration (must match VITE_FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=your_project_id

# Controlled Demo Authentication (set to 'true' for PromptWars live evaluation; defaults to false in production)
DEMO_MODE=false

# ------------------------------------------------------------------------------
# Client Environment Variables (client/.env)
# Must begin with VITE_ to be exposed to Vite client bundle
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000

# Firebase Client SDK Configuration
# Found in Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

