{
  "name": "fixora",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fixora - AI-powered campus issue reporting and resolution platform",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build:shared": "npm run build --workspace=shared",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "test": "npm run test --workspace=server && npm run test --workspace=client",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "test:watch": "npm run test:watch --workspace=server"
  },
  "keywords": [
    "campus-issues",
    "fixora",
    "promptwars",
    "firebase",
    "express",
    "react"
  ],
  "author": "Fixora Engineering Team",
  "license": "UNLICENSED"
}
